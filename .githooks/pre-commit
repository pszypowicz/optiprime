#!/usr/bin/env bash
# Runs the shared repo checks (the same script CI runs) before each commit.
# Enable with: git config core.hooksPath .githooks

set -euo pipefail

# Skip when the commit touches nothing the checks validate.
if git diff --cached --quiet -- '*.go' go.mod go.sum; then
    exit 0
fi

exec "$(git rev-parse --show-toplevel)/.github/scripts/checks.sh"
